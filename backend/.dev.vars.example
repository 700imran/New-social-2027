# Copy this file to .dev.vars for local `wrangler dev` (gitignored).
# In production set the same names with: npx wrangler secret put NAME

# Supabase project settings -> API
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Supabase project settings -> API -> JWT Settings -> JWT Secret
# (legacy HS256 shared secret; used to verify the JWT on every request)
SUPABASE_JWT_SECRET=

# Cloudflare dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
