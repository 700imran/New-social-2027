# Copy this file to .env.local (gitignored — matches *.local) and fill in
# your deployed Worker URL to switch the app from mock mode to your real
# Supabase + Cloudflare backend. Leave .env.local absent/unset and the app
# runs exactly as it always has: fully interactive, no backend required.
#
# Must include the /v1 prefix. Examples:
#   Local `wrangler dev`:      http://localhost:8787/v1
#   Deployed Worker:           https://bharatspace-api.YOUR-SUBDOMAIN.workers.dev/v1
#   Deployed + custom domain:  https://api.yourdomain.com/v1
#
# Full walkthrough: docs/CONNECT_EXISTING_INFRA.md
VITE_API_BASE_URL=

# Optional. Cloudflare dashboard -> Turnstile -> your widget -> Site Key
# (the public one — NOT the secret key, which is a backend-only Worker
# secret, see backend/.dev.vars.example). Leave unset and the signup form
# renders without a bot-check widget; the backend already handles this
# case gracefully. Free and unlimited. See docs/SECURITY.md.
VITE_TURNSTILE_SITE_KEY=
