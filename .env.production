# Baked in for the production build — the app connects to this backend
# by default now. Vite inlines this into the built JS at build time (see
# npm run build), so this is intentionally committed, not a secret: the
# same URL is visible to anyone opening browser devtools on the deployed
# site anyway. See ../docs/GO_LIVE_CHECKLIST.md.
VITE_API_BASE_URL=https://new-social-2027.imrankhan210r.workers.dev/v1

# Optional — leave blank until you've created a Turnstile widget
# (docs/SECURITY.md §2). Signup/login work fine without it.
VITE_TURNSTILE_SITE_KEY=
