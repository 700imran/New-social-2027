diff --git a/src/utils/usePushNotifications.js b/src/utils/usePushNotifications.js
new file mode 100644
index 0000000..5747f88
--- /dev/null
+++ b/src/utils/usePushNotifications.js
@@ -0,0 +1,76 @@
+import { useEffect, useRef } from 'react'
+import { useApp } from '../context/AppContext.jsx'
+import * as api from '../api/client.js'
+import { isLive } from '../api/client.js'
+
+// Mounted once at the app root (see App.jsx). Registers this device for
+// real, OS-level push notifications (the kind that show up in the phone's
+// notification tray while the app is closed, per backend/src/lib/push.js)
+// the moment someone is signed in, and unregisters on sign-out so a
+// shared/reused device stops receiving that account's pushes right away
+// rather than waiting for whoever signs in next to overwrite the row.
+//
+// A silent no-op everywhere this genuinely can't do anything useful, none
+// of which are errors:
+//  - the web build (Capacitor.isNativePlatform() false) — browsers need a
+//    separate Web Push flow (a service worker + VAPID keys) this doesn't
+//    implement, since the app's primary target is the Android build;
+//  - mock/demo mode (isLive false) — there's no backend to register a
+//    token with;
+//  - the person denying the permission prompt (PushNotifications
+//    .requestPermissions() resolving to anything other than 'granted') —
+//    a completely normal, expected outcome, not a failure to log.
+export function usePushNotifications() {
+  const { isAuthenticated } = useApp()
+  const tokenRef = useRef(null)
+
+  useEffect(() => {
+    if (!isAuthenticated || !isLive) return undefined
+    let cancelled = false
+    let listenerHandles = []
+
+    import('@capacitor/core')
+      .then(({ Capacitor }) => {
+        if (cancelled || !Capacitor?.isNativePlatform?.()) return null
+        return import('@capacitor/push-notifications').then((mod) => mod.PushNotifications)
+      })
+      .then(async (PushNotifications) => {
+        if (cancelled || !PushNotifications) return
+
+        listenerHandles = await Promise.all([
+          PushNotifications.addListener('registration', (token) => {
+            tokenRef.current = token.value
+            api.registerDeviceToken(token.value, 'android').catch(() => {})
+          }),
+          PushNotifications.addListener('registrationError', (err) => {
+            console.error('[push] device registration failed', err)
+          }),
+        ])
+        if (cancelled) {
+          listenerHandles.forEach((h) => h.remove())
+          return
+        }
+
+        const status = await PushNotifications.requestPermissions()
+        if (!cancelled && status.receive === 'granted') await PushNotifications.register()
+      })
+      .catch(() => {
+        // No native PushNotifications plugin available (plain web/dev
+        // build) — nothing to register.
+      })
+
+    return () => {
+      cancelled = true
+      listenerHandles.forEach((h) => h.remove())
+    }
+  }, [isAuthenticated])
+
+  // Separate from the effect above so the token survives the transition:
+  // this only fires the moment `isAuthenticated` flips to false, using
+  // whatever registration effect already captured in tokenRef.
+  useEffect(() => {
+    if (isAuthenticated || !tokenRef.current || !isLive) return
+    api.unregisterDeviceToken(tokenRef.current).catch(() => {})
+    tokenRef.current = null
+  }, [isAuthenticated])
+}
