+    .from('live_streams')
+    .select('id, host_id, title, status, started_at')
+    .eq('id', c.req.param('id'))
+    .single()
+  if (error || !stream) return c.json({ error: 'Stream not found' }, 404)
+
+  const { data: profile } = await supabase
+    .from('profiles')
+    .select('display_name, avatar_asset_id')
+    .eq('user_id', stream.host_id)
+    .single()
+  let hostAvatarUrl = null
+  if (profile?.avatar_asset_id) {
+    const { data: asset } = await supabase
+      .from('media_assets')
+      .select('storage_key')
+      .eq('id', profile.avatar_asset_id)
+      .single()
+    if (asset?.storage_key) hostAvatarUrl = `${c.env.R2_PUBLIC_BASE_URL}/${asset.storage_key}`
+  }
+
+  return c.json({
+    id: stream.id,
+    hostId: stream.host_id,
+    hostName: profile?.display_name || 'BharatSpace user',
+    hostAvatarUrl,
+    title: stream.title,
+    status: stream.status,
+    startedAt: stream.started_at,
+  })
+})
+
