diff --git a/backend/src/routes/pushTokens.js b/backend/src/routes/pushTokens.js
new file mode 100644
index 0000000..539b5d0
--- /dev/null
+++ b/backend/src/routes/pushTokens.js
@@ -0,0 +1,51 @@
+import { Hono } from 'hono'
+import { userClient, adminClient } from '../lib/supabase.js'
+import { dbError } from '../lib/errorHandler.js'
+import { requireAuth } from '../lib/authMiddleware.js'
+import { requireText } from '../lib/security.js'
+
+const pushTokens = new Hono()
+
+const PLATFORMS = ['android', 'ios', 'web']
+
+// POST /v1/device-tokens { token, platform } — called from
+// src/utils/usePushNotifications.js right after
+// PushNotifications.register() resolves. Uses the admin client rather
+// than the caller's own RLS-scoped one because RLS can only let someone
+// update a device_tokens row they already own (see
+// docs/migrations/022_device_push_tokens.sql) — if this device
+// previously belonged to a different, since-signed-out account, this
+// upsert needs to reassign that same row to the new one, which is
+// exactly the "admin-curated action on the caller's own behalf" escape
+// hatch lib/notify.js already uses this client for.
+pushTokens.post('/device-tokens', requireAuth, async (c) => {
+  const body = await c.req.json().catch(() => ({}))
+  const v = requireText(body.token, { field: 'token', max: 4096 })
+  if (v.error) return c.json({ error: v.error }, 400)
+  const platform = PLATFORMS.includes(body.platform) ? body.platform : 'android'
+
+  const supabase = adminClient(c.env)
+  const { error } = await supabase
+    .from('device_tokens')
+    .upsert(
+      { token: v.value, user_id: c.get('userId'), platform, updated_at: new Date().toISOString() },
+      { onConflict: 'token' }
+    )
+  if (error) return dbError(c, error, 'Could not register this device for notifications')
+  return c.json({ ok: true })
+})
+
+// DELETE /v1/device-tokens { token } — called on sign-out so a shared or
+// reused device stops receiving this account's pushes immediately,
+// rather than waiting for whoever signs in next to overwrite the row.
+pushTokens.delete('/device-tokens', requireAuth, async (c) => {
+  const body = await c.req.json().catch(() => ({}))
+  if (!body.token) return c.json({ error: 'token is required' }, 400)
+
+  const supabase = userClient(c.env, c.get('jwt'))
+  const { error } = await supabase.from('device_tokens').delete().eq('token', body.token).eq('user_id', c.get('userId'))
+  if (error) return dbError(c, error)
+  return c.json({ ok: true })
+})
+
+export default pushTokens
