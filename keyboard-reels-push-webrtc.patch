+// stock/Pixel-style (AOSP) launchers only ever show a plain dot, driven
+// by whether there's an active system notification rather than a number
+// this API sets — that's a platform limitation @capawesome/capacitor-badge
+// itself can't work around, not a bug in this integration.
+export function useAppBadge() {
+  const { isAuthenticated, unreadCount, unreadMessagesCount } = useApp()
+
+  useEffect(() => {
+    let cancelled = false
+    const count = isAuthenticated ? unreadCount + unreadMessagesCount : 0
+
+    import('@capacitor/core')
+      .then(({ Capacitor }) => {
+        if (cancelled || !Capacitor?.isNativePlatform?.()) return null
+        return import('@capawesome/capacitor-badge').then((mod) => mod.Badge)
+      })
+      .then(async (Badge) => {
+        if (cancelled || !Badge) return
+        if (count > 0) await Badge.set({ count }).catch(() => {})
+        else await Badge.clear().catch(() => {})
+      })
+      .catch(() => {
+        // No native Badge plugin available (plain web/dev build) —
+        // nothing to sync.
+      })
+
+    return () => {
+      cancelled = true
+    }
+  }, [isAuthenticated, unreadCount, unreadMessagesCount])
+}
