diff --git a/backend/src/lib/push.js b/backend/src/lib/push.js
new file mode 100644
index 0000000..b885e69
--- /dev/null
+++ b/backend/src/lib/push.js
@@ -0,0 +1,159 @@
+// lib/push.js — sends real, OS-level push notifications (the kind that
+// show up in the phone's notification tray while the app is closed) via
+// Firebase Cloud Messaging's HTTP v1 API. Called from notify.js (likes,
+// comments, follows, mentions) and routes/messages.js (new DMs) whenever
+// the recipient has a device token on file — see
+// docs/migrations/022_device_push_tokens.sql and routes/pushTokens.js
+// for how those get there.
+//
+// Why this hand-rolls a JWT instead of using the firebase-admin SDK: that
+// SDK depends on Node APIs Workers' runtime doesn't provide. This
+// implements the same OAuth2 service-account flow Google documents,
+// entirely with the Web Crypto API, which Workers does support natively.
+//
+// Requires one secret — `wrangler secret put FCM_SERVICE_ACCOUNT_JSON`,
+// the *entire* JSON key file downloaded from Firebase console -> Project
+// settings -> Service accounts -> Generate new private key, pasted in as
+// one line. See docs/PUSH_NOTIFICATIONS_SETUP.md for the full walkthrough
+// (creating the Firebase project, wiring the Android app to it, and
+// setting this secret) — that setup can only be done by whoever owns the
+// Firebase account, so every function below is a silent no-op (not an
+// error) until it's done, the same "not configured yet" shape
+// email.js's RESEND_API_KEY check already uses elsewhere in this
+// backend. A deployment that hasn't done that setup keeps working
+// exactly as it did before this file existed; recipients just don't get
+// a system-tray notification yet, only the existing in-app one.
+import { adminClient } from './supabase.js'
+
+function base64UrlFromString(str) {
+  return btoa(unescape(encodeURIComponent(str)))
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '')
+}
+
+function base64UrlFromBuffer(buf) {
+  let binary = ''
+  const bytes = new Uint8Array(buf)
+  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i])
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')
+}
+
+function pemToBuffer(pem) {
+  const b64 = pem
+    .replace(/-----BEGIN PRIVATE KEY-----/, '')
+    .replace(/-----END PRIVATE KEY-----/, '')
+    .replace(/\s+/g, '')
+  const binary = atob(b64)
+  const bytes = new Uint8Array(binary.length)
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i)
+  return bytes.buffer
+}
+
+// Cached per Worker isolate — an FCM access token is valid for an hour,
+// and re-signing a fresh JWT plus round-tripping to Google's token
+// endpoint on every single notification would be both slower and
+// needlessly hard on that endpoint. Harmless if the isolate recycles
+// sooner than that; it just re-mints next call.
+let cachedAuth = null // { accessToken, projectId, expiresAtMs }
+
+async function getAccessToken(env) {
+  if (cachedAuth && Date.now() < cachedAuth.expiresAtMs - 60_000) return cachedAuth
+
+  const serviceAccount = JSON.parse(env.FCM_SERVICE_ACCOUNT_JSON)
+  const nowSec = Math.floor(Date.now() / 1000)
+  const header = base64UrlFromString(JSON.stringify({ alg: 'RS256', typ: 'JWT' }))
+  const claims = base64UrlFromString(
+    JSON.stringify({
+      iss: serviceAccount.client_email,
+      scope: 'https://www.googleapis.com/auth/firebase.messaging',
+      aud: 'https://oauth2.googleapis.com/token',
+      iat: nowSec,
+      exp: nowSec + 3600,
+    })
+  )
+  const signingInput = `${header}.${claims}`
+
+  const key = await crypto.subtle.importKey(
+    'pkcs8',
+    pemToBuffer(serviceAccount.private_key),
+    { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' },
+    false,
+    ['sign']
+  )
+  const signature = await crypto.subtle.sign('RSASSA-PKCS1-v1_5', key, new TextEncoder().encode(signingInput))
+  const assertion = `${signingInput}.${base64UrlFromBuffer(signature)}`
+
+  const res = await fetch('https://oauth2.googleapis.com/token', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams({
+      grant_type: 'urn:ietf:params:oauth:grant-type:jwt-bearer',
+      assertion,
+    }),
+  })
+  if (!res.ok) throw new Error(`FCM token exchange failed: ${res.status} ${await res.text()}`)
+  const json = await res.json()
+
+  cachedAuth = {
+    accessToken: json.access_token,
+    projectId: serviceAccount.project_id,
+    expiresAtMs: Date.now() + json.expires_in * 1000,
+  }
+  return cachedAuth
+}
+
+// Sends `{ title, body, data }` as a real push to every device `userId`
+// has registered (routes/pushTokens.js). Never throws — a push failure
+// (or Firebase simply not being configured yet) must never take down the
+// in-app action that triggered it (liking a post, sending a DM, etc.),
+// which is why every caller treats this as fire-and-forget.
+export async function sendPush(env, userId, { title, body, data } = {}) {
+  if (!env.FCM_SERVICE_ACCOUNT_JSON || !userId) return
+
+  try {
+    const supabase = adminClient(env)
+    const { data: rows } = await supabase.from('device_tokens').select('token').eq('user_id', userId)
+    const tokens = (rows || []).map((r) => r.token)
+    if (!tokens.length) return
+
+    const { accessToken, projectId } = await getAccessToken(env)
+    const stringData = data
+      ? Object.fromEntries(Object.entries(data).map(([k, v]) => [k, String(v)]))
+      : undefined
+
+    const results = await Promise.allSettled(
+      tokens.map(async (token) => {
+        const res = await fetch(`https://fcm.googleapis.com/v1/projects/${projectId}/messages:send`, {
+          method: 'POST',
+          headers: { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            message: {
+              token,
+              notification: { title, body },
+              data: stringData,
+              android: { priority: 'high' },
+            },
+          }),
+        })
+        if (!res.ok) {
+          const errJson = await res.json().catch(() => ({}))
+          const reason = errJson?.error?.details?.find((d) => d.errorCode)?.errorCode
+          if (reason === 'UNREGISTERED' || reason === 'INVALID_ARGUMENT') {
+            // The app was uninstalled or the token rotated on Google's
+            // side — clean it up so future sends don't keep paying for
+            // (and retrying) a token that will never deliver again.
+            await supabase.from('device_tokens').delete().eq('token', token)
+          } else {
+            throw new Error(`FCM send failed: ${res.status} ${JSON.stringify(errJson)}`)
+          }
+        }
+      })
+    )
+    results.forEach((r) => {
+      if (r.status === 'rejected') console.error('[push] send failed for one device', r.reason)
+    })
+  } catch (err) {
+    console.error('[push] sendPush failed', err)
+  }
+}
