new file mode 100644
index 0000000..abb9703
--- /dev/null
+++ b/src/utils/webrtc.js
@@ -0,0 +1,24 @@
+// Shared ICE server list for every real-time audio/video connection in
+// the app (Call.jsx's 1:1 calls, LiveGo.jsx/LiveView.jsx's live-stream
+// broadcast) — one place to change this rather than three.
+//
+// STUN only, no TURN. STUN (these servers) is what lets two devices
+// behind ordinary home/office/mobile-carrier NAT discover a direct
+// path to each other — it's free, needs no account, and is enough for
+// the large majority of real networks. What it can't do is relay media
+// when a direct path genuinely isn't possible (symmetric NAT on one or
+// both sides — common on some corporate networks and a minority of
+// mobile carriers) — that needs a TURN server, which actually proxies
+// the audio/video and therefore isn't free to run at scale. There's no
+// TURN server configured here because that requires an account with a
+// provider (or self-hosting coturn) — this project already runs its
+// backend on Cloudflare, whose own Realtime TURN service
+// (https://developers.cloudflare.com/realtime/turn/) is a natural fit
+// if calls/live streams turn out to fail for people on restrictive
+// networks; wiring that in is a follow-up, not something a STUN-only
+// list can be turned into by itself.
+export const ICE_SERVERS = [
+  { urls: 'stun:stun.cloudflare.com:3478' },
+  { urls: 'stun:stun.l.google.com:19302' },
+  { urls: 'stun:stun1.l.google.com:19302' },
+]
